---
import Button from '../ui/Button.astro';

type ContactSource = 'footer' | 'contacto';

interface Props {
  source: ContactSource;
  title?: string;
  intro?: string;
  class?: string;
}

const {
  source,
  title = 'Cuentanos el desafío',
  intro = 'Comparte el flujo, fricción u oportunidad que quieres revisar y te responderemos por correo.',
  class: className = '',
} = Astro.props;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const contactEndpointUrl = import.meta.env.PUBLIC_CONTACT_ENDPOINT_URL ?? '';
const isConfigured = Boolean(turnstileSiteKey && contactEndpointUrl);
const formId = `contact-form-${source}`;
---

<div class={`rounded-[1.75rem] bg-white p-6 text-phx-6 shadow-panel ${className}`}>
  <div class="space-y-2">
    <h3 class="text-2xl font-semibold text-phx-6">{title}</h3>
    <p class="text-sm leading-6 text-phx-7">{intro}</p>
  </div>

  <form
    aria-describedby={`${formId}-status`}
    class="mt-6 grid gap-4"
    data-contact-form
    data-endpoint={contactEndpointUrl}
    data-site-key={turnstileSiteKey}
    data-source={source}
    id={formId}
    novalidate
  >
    <div class="grid gap-4 md:grid-cols-2">
      <label class="grid gap-2 text-sm font-medium text-phx-6">
        <span>Nombre</span>
        <span class="relative block">
          <input
            aria-describedby={`${formId}-name-error`}
            class="block w-full rounded-2xl border border-phx-8 bg-white px-4 py-3 text-sm text-phx-6 outline-none transition focus:border-phx-3 focus:ring-4 focus:ring-phx-4/60"
            data-field="name"
            maxlength="120"
            minlength="2"
            name="name"
            placeholder="Como te gustaría que te contactemos"
            required
            type="text"
          />
          <span
            aria-live="polite"
            class="absolute left-2 right-2 top-full z-20 mt-2 hidden rounded-xl border border-rose-200 bg-white px-3 py-2 text-xs font-medium leading-5 text-rose-700 shadow-[0_10px_30px_rgba(15,23,42,0.14)] break-words before:absolute before:-top-[7px] before:left-5 before:h-3 before:w-3 before:rotate-45 before:border-l before:border-t before:border-rose-200 before:bg-white sm:left-4 sm:right-auto sm:max-w-[15rem]"
            data-field-error="name"
            id={`${formId}-name-error`}
            role="alert"
          ></span>
        </span>
      </label>
      <label class="grid gap-2 text-sm font-medium text-phx-6">
        <span>Empresa</span>
        <span class="relative block">
          <input
            aria-describedby={`${formId}-company-error`}
            class="block w-full rounded-2xl border border-phx-8 bg-white px-4 py-3 text-sm text-phx-6 outline-none transition focus:border-phx-3 focus:ring-4 focus:ring-phx-4/60"
            data-field="company"
            maxlength="120"
            name="company"
            placeholder="Empresa o área responsable"
            type="text"
          />
          <span
            aria-live="polite"
            class="absolute left-2 right-2 top-full z-20 mt-2 hidden rounded-xl border border-rose-200 bg-white px-3 py-2 text-xs font-medium leading-5 text-rose-700 shadow-[0_10px_30px_rgba(15,23,42,0.14)] break-words before:absolute before:-top-[7px] before:left-5 before:h-3 before:w-3 before:rotate-45 before:border-l before:border-t before:border-rose-200 before:bg-white sm:left-4 sm:right-auto sm:max-w-[15rem]"
            data-field-error="company"
            id={`${formId}-company-error`}
            role="alert"
          ></span>
        </span>
      </label>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      <label class="grid gap-2 text-sm font-medium text-phx-6">
        <span>Correo</span>
        <span class="relative block">
          <input
            aria-describedby={`${formId}-email-error`}
            class="block w-full rounded-2xl border border-phx-8 bg-white px-4 py-3 text-sm text-phx-6 outline-none transition focus:border-phx-3 focus:ring-4 focus:ring-phx-4/60"
            data-field="email"
            maxlength="160"
            name="email"
            placeholder="nombre@empresa.cl"
            required
            type="email"
          />
          <span
            aria-live="polite"
            class="absolute left-2 right-2 top-full z-20 mt-2 hidden rounded-xl border border-rose-200 bg-white px-3 py-2 text-xs font-medium leading-5 text-rose-700 shadow-[0_10px_30px_rgba(15,23,42,0.14)] break-words before:absolute before:-top-[7px] before:left-5 before:h-3 before:w-3 before:rotate-45 before:border-l before:border-t before:border-rose-200 before:bg-white sm:left-4 sm:right-auto sm:max-w-[15rem]"
            data-field-error="email"
            id={`${formId}-email-error`}
            role="alert"
          ></span>
        </span>
      </label>
      <label class="grid gap-2 text-sm font-medium text-phx-6">
        <span>Teléfono</span>
        <span class="relative block">
          <input
            aria-describedby={`${formId}-phone-error`}
            class="block w-full rounded-2xl border border-phx-8 bg-white px-4 py-3 text-sm text-phx-6 outline-none transition focus:border-phx-3 focus:ring-4 focus:ring-phx-4/60"
            data-field="phone"
            maxlength="32"
            name="phone"
            placeholder="+56 9 1234 5678"
            type="tel"
          />
          <span
            aria-live="polite"
            class="absolute left-2 right-2 top-full z-20 mt-2 hidden rounded-xl border border-rose-200 bg-white px-3 py-2 text-xs font-medium leading-5 text-rose-700 shadow-[0_10px_30px_rgba(15,23,42,0.14)] break-words before:absolute before:-top-[7px] before:left-5 before:h-3 before:w-3 before:rotate-45 before:border-l before:border-t before:border-rose-200 before:bg-white sm:left-4 sm:right-auto sm:max-w-[15rem]"
            data-field-error="phone"
            id={`${formId}-phone-error`}
            role="alert"
          ></span>
        </span>
      </label>
    </div>

    <label class="grid gap-2 text-sm font-medium text-phx-6">
      <span>Mensaje</span>
      <span class="relative block">
        <textarea
          aria-describedby={`${formId}-message-error`}
          class="block min-h-[8rem] w-full rounded-2xl border border-phx-8 bg-white px-4 py-3 text-sm text-phx-6 outline-none transition focus:border-phx-3 focus:ring-4 focus:ring-phx-4/60"
          data-field="message"
          maxlength="2000"
          minlength="10"
          name="message"
          placeholder="Describe el flujo, problema u oportunidad que quieres revisar. Mientras mas contexto compartas, mejor podremos responder."
          required
        ></textarea>
        <span
          aria-live="polite"
          class="absolute left-2 right-2 top-full z-20 mt-2 hidden rounded-xl border border-rose-200 bg-white px-3 py-2 text-xs font-medium leading-5 text-rose-700 shadow-[0_10px_30px_rgba(15,23,42,0.14)] break-words before:absolute before:-top-[7px] before:left-5 before:h-3 before:w-3 before:rotate-45 before:border-l before:border-t before:border-rose-200 before:bg-white sm:left-4 sm:right-auto sm:max-w-[22rem]"
          data-field-error="message"
          id={`${formId}-message-error`}
          role="alert"
        ></span>
      </span>
    </label>

    <div aria-hidden="true" class="hidden">
      <label>
        Website
        <input autocomplete="off" name="website" tabindex="-1" type="text" />
      </label>
    </div>

    <div class="space-y-3">
      <div class="min-h-[80px] rounded-2xl border border-dashed border-phx-8 bg-phx-5/60 px-3 py-3">
        {isConfigured ? (
          <div class="flex min-h-[52px] items-center" data-turnstile-container></div>
        ) : (
          <p class="text-sm leading-6 text-amber-700">
            Configura <code>PUBLIC_TURNSTILE_SITE_KEY</code> y <code>PUBLIC_CONTACT_ENDPOINT_URL</code> para activar el envio.
          </p>
        )}
      </div>
      <p class="text-xs leading-5 text-phx-7">
        Este formulario esta protegido por Cloudflare Turnstile para reducir envios automatizados.
      </p>
    </div>

    <div class="flex flex-col gap-3">
      <Button data-submit-button size="sm" type="submit">
        Enviar
      </Button>
      <p class="min-h-[1.5rem] text-sm leading-6 text-phx-7" id={`${formId}-status`} data-form-status role="status"></p>
    </div>
  </form>

  <dialog
    aria-live="polite"
    class="pointer-events-none invisible fixed bottom-4 left-1/2 z-50 flex -translate-x-1/2 rounded-2xl border border-emerald-200 bg-emerald-50 p-0 text-emerald-900 opacity-0 shadow-lg transition duration-300"
    data-feedback-dialog="success"
  >
    <div class="p-4 text-center text-sm leading-6">
      <p data-feedback-message="success">Mensaje enviado correctamente. Te responderemos por correo.</p>
    </div>
  </dialog>

  <dialog
    aria-live="assertive"
    class="pointer-events-none invisible fixed bottom-4 left-1/2 z-50 flex -translate-x-1/2 rounded-2xl border border-rose-200 bg-rose-50 p-0 text-rose-900 opacity-0 shadow-lg transition duration-300"
    data-feedback-dialog="error"
  >
    <div class="p-4 text-center text-sm leading-6">
      <p data-feedback-message="error">No pudimos enviar tu mensaje. Intenta nuevamente o escribenos por correo.</p>
    </div>
  </dialog>
</div>

<script>
  const TURNSTILE_SCRIPT_URL = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
  let turnstileScriptPromise;
  const feedbackTimers = new WeakMap();

  function loadTurnstileScript() {
    if (window.turnstile) {
      return Promise.resolve(window.turnstile);
    }

    if (turnstileScriptPromise) {
      return turnstileScriptPromise;
    }

    turnstileScriptPromise = new Promise((resolve, reject) => {
      const existingScript = document.querySelector(`script[src="${TURNSTILE_SCRIPT_URL}"]`);

      if (existingScript) {
        existingScript.addEventListener('load', () => resolve(window.turnstile), { once: true });
        existingScript.addEventListener('error', () => reject(new Error('turnstile_script_failed')), { once: true });
        return;
      }

      const script = document.createElement('script');
      script.src = TURNSTILE_SCRIPT_URL;
      script.async = true;
      script.defer = true;
      script.onload = () => resolve(window.turnstile);
      script.onerror = () => reject(new Error('turnstile_script_failed'));
      document.head.appendChild(script);
    });

    return turnstileScriptPromise;
  }

  function setStatus(form, message, tone = 'muted') {
    const status = form.querySelector('[data-form-status]');
    if (!status) return;

    status.textContent = message;
    status.classList.remove('text-phx-7', 'text-emerald-700', 'text-rose-700', 'text-amber-700');

    if (tone === 'success') {
      status.classList.add('text-emerald-700');
      return;
    }

    if (tone === 'error') {
      status.classList.add('text-rose-700');
      return;
    }

    if (tone === 'warning') {
      status.classList.add('text-amber-700');
      return;
    }

    status.classList.add('text-phx-7');
  }

  function showFeedbackDialog(form, tone, message) {
    const dialog = form.parentElement?.querySelector(`[data-feedback-dialog="${tone}"]`);
    const messageNode = dialog?.querySelector(`[data-feedback-message="${tone}"]`);

    if (!dialog || !messageNode) return;

    messageNode.textContent = message;
    dialog.classList.remove('invisible');
    dialog.classList.add('opacity-100');

    const activeTimers = feedbackTimers.get(dialog);
    if (activeTimers) {
      clearTimeout(activeTimers.fadeTimer);
      clearTimeout(activeTimers.hideTimer);
    }

    const fadeTimer = window.setTimeout(() => {
      dialog.classList.remove('opacity-100');

      const hideTimer = window.setTimeout(() => {
        dialog.classList.add('invisible');
      }, 300);

      feedbackTimers.set(dialog, { fadeTimer, hideTimer });
    }, tone === 'success' ? 5000 : 7000);

    feedbackTimers.set(dialog, { fadeTimer, hideTimer: 0 });
  }

  function setSubmitting(form, isSubmitting) {
    const submitButton = form.querySelector('[data-submit-button]');
    if (!submitButton) return;

    submitButton.disabled = isSubmitting;
    submitButton.textContent = isSubmitting ? 'Enviando...' : 'Enviar';
  }

  function normalizePayload(form, token) {
    const formData = new FormData(form);
    return {
      name: String(formData.get('name') || '').trim(),
      company: String(formData.get('company') || '').trim(),
      email: String(formData.get('email') || '').trim(),
      phone: String(formData.get('phone') || '').trim(),
      message: String(formData.get('message') || '').trim(),
      source: String(form.dataset.source || ''),
      website: String(formData.get('website') || '').trim(),
      'cf-turnstile-response': token,
    };
  }

  function validatePayload(payload) {
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const errors = {};

    if (payload.name.length < 2 || payload.name.length > 120) {
      errors.name = 'Ingresa un nombre válido de al menos 2 caracteres.';
    }

    if (!emailPattern.test(payload.email) || payload.email.length > 160) {
      errors.email = 'Ingresa un correo válido para poder responderte.';
    }

    if (payload.company.length > 120) {
      errors.company = 'El nombre de la empresa es demasiado largo.';
    }

    if (payload.phone.length > 32) {
      errors.phone = 'El teléfono es demasiado largo.';
    }

    if (payload.message.length < 10 || payload.message.length > 2000) {
      errors.message = 'Cuéntanos un poco mas sobre el desafío que quieres revisar.';
    }

    return errors;
  }

  function setFieldError(form, fieldName, message = '') {
    const input = form.querySelector(`[data-field="${fieldName}"]`);
    const errorNode = form.querySelector(`[data-field-error="${fieldName}"]`);

    if (!input || !errorNode) return;

    input.setAttribute('aria-invalid', message ? 'true' : 'false');
    input.classList.toggle('border-rose-300', Boolean(message));
    input.classList.toggle('bg-rose-50/40', Boolean(message));
    input.classList.toggle('text-rose-900', Boolean(message));
    input.classList.toggle('focus:border-rose-400', Boolean(message));
    input.classList.toggle('focus:ring-rose-100', Boolean(message));
    input.classList.toggle('border-phx-8', !message);
    input.classList.toggle('bg-white', !message);
    input.classList.toggle('text-phx-6', !message);
    input.classList.toggle('focus:border-phx-3', !message);
    input.classList.toggle('focus:ring-phx-4/60', !message);
    errorNode.textContent = message;
    errorNode.classList.toggle('hidden', !message);
  }

  function clearFieldErrors(form) {
    form.querySelectorAll('[data-field]').forEach((field) => {
      field.setAttribute('aria-invalid', 'false');
    });

    form.querySelectorAll('[data-field-error]').forEach((node) => {
      node.textContent = '';
      node.classList.add('hidden');
    });
  }

  function applyFieldErrors(form, errors) {
    clearFieldErrors(form);

    Object.entries(errors).forEach(([fieldName, message]) => {
      setFieldError(form, fieldName, message);
    });
  }

  function getFirstErrorMessage(errors) {
    return Object.values(errors).find(Boolean) || '';
  }

  function setupForm(form) {
    if (form.dataset.enhanced === 'true') {
      return;
    }

    form.dataset.enhanced = 'true';

    const endpoint = form.dataset.endpoint || '';
    const siteKey = form.dataset.siteKey || '';
    const turnstileContainer = form.querySelector('[data-turnstile-container]');
    let captchaToken = '';
    let widgetId = null;

    const resetWidget = () => {
      captchaToken = '';
      if (window.turnstile && widgetId !== null) {
        window.turnstile.reset(widgetId);
      }
    };

    form.querySelectorAll('[data-field]').forEach((field) => {
      const fieldName = field.getAttribute('data-field');
      if (!fieldName) return;

      const syncField = () => {
        const payload = normalizePayload(form, captchaToken);
        const errors = validatePayload(payload);
        setFieldError(form, fieldName, errors[fieldName] || '');
      };

      field.addEventListener('input', syncField);
      field.addEventListener('blur', syncField);
    });

    if (!endpoint || !siteKey || !turnstileContainer) {
      setStatus(form, 'El formulario todavia no esta configurado para recibir envios.', 'warning');
      return;
    }

    loadTurnstileScript()
      .then((turnstile) => {
        if (!turnstile || widgetId !== null) {
          return;
        }

        widgetId = turnstile.render(turnstileContainer, {
          sitekey: siteKey,
          theme: 'light',
          callback: (token) => {
            captchaToken = token;
            setStatus(form, '');
          },
          'expired-callback': () => {
            captchaToken = '';
            setStatus(form, 'El captcha expiro. Completalo nuevamente para continuar.', 'warning');
          },
          'error-callback': () => {
            captchaToken = '';
            setStatus(form, 'No pudimos validar el captcha. Intenta nuevamente.', 'error');
          },
        });
      })
      .catch(() => {
        setStatus(form, 'No pudimos cargar la validacion anti-bot. Recarga la pagina e intentalo otra vez.', 'error');
      });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const payload = normalizePayload(form, captchaToken);
      const validationErrors = validatePayload(payload);
      const validationMessage = getFirstErrorMessage(validationErrors);

      if (validationMessage) {
        applyFieldErrors(form, validationErrors);
        setStatus(form, validationMessage, 'error');
        showFeedbackDialog(form, 'error', 'Revisa los campos marcados antes de enviar el formulario.');
        return;
      }

      clearFieldErrors(form);

      if (!payload['cf-turnstile-response']) {
        setStatus(form, 'Completa la verificación anti-bot antes de enviar el formulario.', 'warning');
        return;
      }

      setSubmitting(form, true);
      setStatus(form, 'Enviando tu solicitud...', 'muted');

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) {
          if (response.status === 429 || result?.error === 'rate_limit') {
            setStatus(form, 'Recibimos varios intentos seguidos. Espera un momento y vuelve a intentarlo.', 'error');
            showFeedbackDialog(form, 'error', 'Recibimos varios intentos seguidos. Espera un momento y vuelve a intentarlo.');
          } else if (response.status === 403 || result?.error === 'captcha') {
            setStatus(form, 'No pudimos validar el captcha. Intenta nuevamente.', 'error');
            showFeedbackDialog(form, 'error', 'No pudimos validar la verificacion anti-bot. Intenta nuevamente.');
          } else if (response.status === 400 || result?.error === 'validation') {
            setStatus(form, 'Revisa los datos del formulario antes de enviarlo otra vez.', 'error');
            showFeedbackDialog(form, 'error', 'Hay datos pendientes o invalidos en el formulario.');
          } else {
            setStatus(form, 'No fue posible procesar el envío. Intenta nuevamente en unos minutos.', 'error');
            showFeedbackDialog(form, 'error', 'No pudimos enviar tu mensaje. Intenta nuevamente en unos minutos.');
          }

          resetWidget();
          return;
        }

        form.reset();
        clearFieldErrors(form);
        resetWidget();
        setStatus(form, 'Solicitud enviada. Te responderemos a la brevedad.', 'success');
        showFeedbackDialog(form, 'success', 'Mensaje enviado correctamente. Te responderemos a la brevedad.');
      } catch (_error) {
        resetWidget();
        setStatus(form, 'No fue posible procesar el envío. Intenta nuevamente en unos minutos.', 'error');
        showFeedbackDialog(form, 'error', 'No pudimos enviar tu mensaje. Intenta nuevamente en unos minutos.');
      } finally {
        setSubmitting(form, false);
      }
    });
  }

  function initializeContactForms() {
    document.querySelectorAll('[data-contact-form]').forEach((form) => setupForm(form));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeContactForms, { once: true });
  } else {
    initializeContactForms();
  }
</script>
