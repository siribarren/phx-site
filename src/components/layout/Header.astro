---
import Container from './Container.astro';
import Button from '../ui/Button.astro';

const { brand, navigation = [] } = Astro.props;
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-phx-8 bg-white">
  <Container class="flex items-center justify-between gap-6 py-2.5">
    <a class="flex items-center" href="/">
      <img alt={brand.name} class="h-[3.3rem] w-auto md:h-[3.5rem]" src={brand.logo} />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-6 lg:flex">
      {navigation.map((item) => {
        const isActive = item.href === '/' ? pathname === '/' : pathname === '/' && item.href.startsWith('/#');
        return (
          <a
            class:list={[
              'text-sm font-medium transition-colors duration-200',
              isActive ? 'text-phx-2' : 'text-phx-7 hover:text-phx-2',
            ]}
            href={item.href}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden sm:block">
      <Button href="/#footer-contacto" size="sm">Conversemos</Button>
    </div>

    <details class="ml-auto lg:hidden" data-mobile-menu>
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-2xl border border-phx-8 bg-white text-phx-6 transition hover:border-phx-3 hover:text-phx-2">
        <span class="sr-only">Abrir menú</span>
        <span class="flex w-5 flex-col gap-1.5">
          <span class="h-0.5 w-full rounded-full bg-current"></span>
          <span class="h-0.5 w-full rounded-full bg-current"></span>
          <span class="h-0.5 w-full rounded-full bg-current"></span>
        </span>
      </summary>

      <div class="absolute inset-x-0 top-full border-t border-phx-8 bg-white shadow-[0_18px_40px_rgba(15,23,42,0.08)]">
        <Container class="py-4">
          <nav aria-label="Principal móvil" class="grid gap-2">
            {navigation.map((item) => {
              const isActive = item.href === '/' ? pathname === '/' : pathname === '/' && item.href.startsWith('/#');
              return (
                <a
                  class:list={[
                    'rounded-2xl border px-4 py-3 text-sm font-medium transition-colors',
                    isActive
                      ? 'border-phx-3 bg-phx-4 text-phx-2'
                      : 'border-phx-8 bg-white text-phx-7 hover:border-phx-3 hover:text-phx-2',
                  ]}
                  data-mobile-menu-link
                  href={item.href}
                >
                  {item.label}
                </a>
              );
            })}
            <Button data-mobile-menu-link href="/#footer-contacto" size="sm">Conversemos</Button>
          </nav>
        </Container>
      </div>
    </details>
  </Container>
</header>

<script>
  function setupMobileMenu() {
    document.querySelectorAll('[data-mobile-menu]').forEach((menu) => {
      if (menu.dataset.enhanced === 'true') return;
      menu.dataset.enhanced = 'true';

      const closeMenu = () => {
        menu.removeAttribute('open');
      };

      menu.querySelectorAll('[data-mobile-menu-link]').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
