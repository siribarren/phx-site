---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';

const {
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="py-16 md:py-20">
  <Container>
    <div class="rounded-[2rem] border border-phx-8 bg-white px-8 py-10 shadow-panel md:px-12 md:py-14">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
        <div class="space-y-4">
          <p class="text-sm font-semibold tracking-[0.02em] text-phx-2">Siguiente paso</p>
          <h2 class="text-3xl font-semibold tracking-tight text-phx-6 md:text-4xl">{title}</h2>
          <p class="max-w-2xl text-base leading-7 text-phx-7 md:text-lg">{description}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <Button href={primaryHref}>{primaryLabel}</Button>
          {secondaryLabel && secondaryHref && (
            <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
          )}
        </div>
      </div>
    </div>
  </Container>
</section>
