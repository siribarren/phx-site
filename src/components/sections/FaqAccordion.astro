---
import Container from '../layout/Container.astro';
import faqs from '../../data/faqs.json';
---

<section class="scroll-mt-16 py-16 md:py-20" id="preguntas">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-4">
        <p class="text-sm font-semibold tracking-[0.02em] text-phx-2">Preguntas</p>
        <h2 class="text-3xl font-semibold tracking-tight text-phx-6 md:text-4xl">
          Respuestas claras para una conversacion de negocio mas concreta
        </h2>
        <p class="max-w-xl text-base leading-7 text-phx-7 md:text-lg">
          Esta seccion resume como trabaja PHX, cuando tiene sentido iniciar un proyecto y que tipo de problemas vale la pena priorizar.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((item) => (
          <details class="group rounded-[1.75rem] border border-phx-8 bg-white px-6 py-5 shadow-panel">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-phx-6">
              <span>{item.question}</span>
              <span class="text-2xl text-phx-2 transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <p class="pt-4 text-base leading-7 text-phx-7">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </Container>
</section>
