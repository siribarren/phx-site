---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';

const {
  title,
  subtitle,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="relative overflow-hidden pb-20 pt-14 md:pb-28 md:pt-10">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:items-end">
      <div class="space-y-8 md:-mt-8">
        <div class="space-y-4">
          <h1 class="max-w-4xl text-5xl font-semibold tracking-tight text-phx-6 md:text-6xl">
            Sistemas inteligentes <span class="text-phx-1">mejorando negocios</span>
          </h1>
          <p class="max-w-2xl text-lg leading-8 text-phx-7 md:text-xl">{subtitle}</p>
        </div>

        <div class="flex flex-col gap-4 sm:flex-row">
          <Button href={primaryHref}>{primaryLabel}</Button>
          <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
        </div>
      </div>

      <div class="rounded-[2rem] border border-phx-8 bg-white p-8 shadow-panel">
        <p class="text-sm font-semibold tracking-[0.02em] text-phx-2">Enfoque</p>
        <div class="mt-6 space-y-5">
          <div>
            <p class="text-3xl font-semibold text-phx-6">Operación primero</p>
            <p class="mt-2 text-base leading-7 text-phx-7">Sistemas útiles para tiempos, decisiones, seguimiento y capacidad real de ejecución.</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl bg-phx-5 p-4">
              <p class="text-sm font-medium text-phx-7">Automatización</p>
              <p class="mt-2 text-xl font-semibold text-phx-6">Flujos coordinados</p>
            </div>
            <div class="rounded-2xl bg-phx-5 p-4">
              <p class="text-sm font-medium text-phx-7">Analítica</p>
              <p class="mt-2 text-xl font-semibold text-phx-6">Decision accionable</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
