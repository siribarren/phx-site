---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';

const {
  title,
  subtitle,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;

const highlightText = 'funcione mejor';
const hasHighlight = title?.includes(highlightText);
const [titlePrefix, titleSuffix] = hasHighlight ? title.split(highlightText) : [title, ''];
const heroPoints = [
  '+20 años de experiencia operativa en gestión de clientes',
  'Aplicable a banca, retail, telecomunicaciones y servicios',
  'Integración real entre datos, procesos, equipos y canales',
];
const focusCards = [
  { label: 'Automatización', title: 'Flujos coordinados' },
  { label: 'Analítica', title: 'Decisión accionable' },
  { label: 'Integración', title: 'Sistemas conectados' },
  { label: 'Ejecución', title: 'Capacidad real' },
];
---

<section class="relative overflow-hidden pb-20 pt-14 md:pb-28 md:pt-10">
  <Container>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:items-end">
      <div class="space-y-8 md:-mt-8">
        <div class="space-y-4">
          <h1 class="max-w-4xl text-5xl font-semibold tracking-tight text-phx-6 md:text-6xl">
            {hasHighlight ? (
              <>
                {titlePrefix}
                <span class="text-phx-1">{highlightText}</span>
                {titleSuffix}
              </>
            ) : (
              title
            )}
          </h1>
          <p class="max-w-2xl text-lg leading-8 text-phx-7 md:text-xl">{subtitle}</p>
        </div>

        <ul class="grid max-w-3xl gap-3">
          {heroPoints.map((point) => (
            <li class="flex items-start gap-3 rounded-2xl border border-phx-8/80 bg-white/75 px-4 py-3 text-sm font-medium leading-6 text-phx-6 shadow-[0_12px_32px_rgba(17,24,39,0.05)] backdrop-blur sm:text-base">
              <span class="mt-2 h-2.5 w-2.5 flex-none rounded-full bg-phx-1"></span>
              <span>{point}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-col gap-4 sm:flex-row">
          <Button href={primaryHref}>{primaryLabel}</Button>
          <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
        </div>
      </div>

      <div class="rounded-[2rem] border border-phx-8 bg-white p-8 shadow-panel">
        <p class="text-xs font-semibold tracking-[0.02em] text-phx-2">Enfoque</p>
        <div class="mt-6 space-y-5">
          <div>
            <p class="text-2xl font-semibold text-phx-6">Operación primero</p>
            <p class="mt-2 text-sm leading-6 text-phx-7">Diseñamos sistemas desde la operación real para mejorar ejecución, decisiones y control.</p>
          </div>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {focusCards.map((card) => (
              <div class="rounded-2xl bg-phx-5 p-4">
                <p class="text-xs font-medium text-phx-7">{card.label}</p>
                <p class="mt-2 text-base font-semibold text-phx-6">{card.title}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
