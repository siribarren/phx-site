---
import Container from '../layout/Container.astro';
import SectionHeading from './SectionHeading.astro';

const { items = [] } = Astro.props;
---

<section class="scroll-mt-16 py-16 md:py-20" id="metodologia">
  <Container class="space-y-10">
    <SectionHeading
      eyebrow="Metodología"
      title="Una secuencia clara para pasar de la fricción a la capacidad escalable"
      description="Trabajamos en cuatro etapas para reducir ambigüedad, acelerar implementacion y medir impacto."
    />

    <ol class="grid gap-5 lg:grid-cols-4">
      {items.map((item) => (
        <li class="rounded-[2rem] border border-phx-8 bg-white p-6 shadow-panel">
          <h3 class="text-2xl font-semibold text-phx-6">{item.step}</h3>
          <p class="mt-3 text-base leading-7 text-phx-7">{item.description}</p>
        </li>
      ))}
    </ol>
  </Container>
</section>
