---
const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  disabled = false,
  class: className = '',
  ...rest
} = Astro.props;

const variants = {
  primary: 'bg-phx-1 text-white hover:bg-phx-2',
  secondary: 'border border-phx-8 bg-white text-phx-6 hover:border-phx-3 hover:text-phx-2',
};

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-5 py-3 text-sm md:text-base',
};

const classes = `inline-flex items-center justify-center rounded-full font-semibold transition-colors duration-200 ${variants[variant]} ${sizes[size]} disabled:cursor-not-allowed disabled:opacity-70 ${className}`;
---

{href ? (
  <a class={classes} href={href} {...rest}>
    <slot />
  </a>
) : (
  <button class={classes} disabled={disabled} type={type} {...rest}>
    <slot />
  </button>
)}
