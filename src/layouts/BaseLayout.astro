---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SEO from '../components/seo/SEO.astro';
import '../assets/styles/global.css';
import brand from '../data/brand.json';
import navigation from '../data/navigation.json';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../lib/constants';

const whatsappHref = 'https://wa.me/56998866033?text=Hola%2C%20te%20escribo%20desde%20el%20sitio%20web%20de%20PHX%20y%20me%20gustar%C3%ADa%20tener%20mas%20informaci%C3%B3n%20de%20sus%20servicios';

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonical = new URL(Astro.url.pathname, SITE_URL).toString(),
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={brand.logo} />
    <SEO title={title} description={description} canonical={canonical} />
    <script async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>
  </head>
  <body class="text-phx-6 antialiased">
    <div class="relative min-h-screen">
      <Header brand={brand} navigation={navigation} />
      <main>
        <slot />
      </main>
      <Footer brand={brand} navigation={navigation} />
      <a
        aria-label="WhatsApp"
        class="fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_16px_32px_rgba(37,211,102,0.28)] transition-transform duration-200 hover:-translate-y-0.5"
        href={whatsappHref}
        rel="noopener noreferrer"
        target="_blank"
      >
        <svg aria-hidden="true" class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19.05 4.94A9.77 9.77 0 0 0 12.09 2c-5.43 0-9.84 4.41-9.84 9.84 0 1.73.45 3.41 1.3 4.9L2 22l5.4-1.42a9.8 9.8 0 0 0 4.69 1.19h.01c5.43 0 9.84-4.41 9.84-9.84a9.77 9.77 0 0 0-2.89-6.99ZM12.1 20.1h-.01a8.13 8.13 0 0 1-4.14-1.13l-.3-.18-3.2.84.86-3.12-.2-.32a8.16 8.16 0 0 1-1.25-4.35c0-4.49 3.66-8.15 8.16-8.15 2.18 0 4.23.85 5.77 2.39a8.1 8.1 0 0 1 2.39 5.77c0 4.5-3.66 8.15-8.15 8.15Zm4.47-6.11c-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.95-1.2-.72-.64-1.21-1.43-1.35-1.67-.14-.24-.01-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.31-.74-1.8-.2-.47-.4-.41-.54-.42h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.68 2.57 4.07 3.6.57.25 1.02.4 1.37.51.58.18 1.1.15 1.51.09.46-.07 1.44-.59 1.64-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.46-.28Z" />
        </svg>
      </a>
    </div>
  </body>
</html>
